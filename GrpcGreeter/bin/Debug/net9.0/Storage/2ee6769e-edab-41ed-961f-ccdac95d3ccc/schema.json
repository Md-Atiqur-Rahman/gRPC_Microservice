{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "description": "Offer NLPI conclusion decision version 0.3.0",
    "type": "object",
    "properties": {
        "processIdentificationNo": {
            "$schema": "https://json-schema.org/draft/2019-09/schema",
            "description": "Unique identification number of the process",
            "type": "string",
            "format": "uuid",
            "example": "632e56bd-5f23-4d5b-b1ca-d8d9ccda278c"
        },
        "timestamp": {
            "$schema": "https://json-schema.org/draft/2019-09/schema",
            "description": "Creation date and time",
            "type": "string",
            "format": "date-time"
        },
        "header": {
            "$schema": "https://json-schema.org/draft/2019-09/schema",
            "description": "Standard header informations",
            "type": "object",
            "properties": {
                "recipient": {
                    "description": "Recipient",
                    "type": "object",
                    "properties": {
                        "broker": {
                            "$schema": "https://json-schema.org/draft/2019-09/schema",
                            "type": "object",
                            "name": "BrokerType",
                            "description": "Broker",
                            "properties": {
                                "brokerRegisterNo": {
                                    "description": "Register number of the broker. Register number for the independent intermediaries as defined by the IG B2B ; prefix with country code and register plus register number FINMA or FMA (example: CHE-FINMA-10001). Note for insurers: For those intermediaries who are not at FINMA or FMA but want to participate on electronic data exchange, e.g., in-house brokers, the code assigned by IG B2B (example: CHE-IGB2B-50001) must be recorded.",
                                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                                    "type": "string",
                                    "maxLength": 19,
                                    "pattern": "^(CHE\\-(FINMA\\-(\\d{5}|\\S{9})|IGB\\dB\\-(\\d{5}))|LIE\\-FMA\\-\\S{5})$"
                                },
                                "companyId": {
                                    "description": "Unique company identification number (UID) for companies based in Switzerland or EU member states as specified in the UID register of the respective authority.",
                                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                                    "name": "CompanyIdType",
                                    "type": "string",
                                    "maxLength": 15,
                                    "pattern": "(CHE|BE|BG|DK|DE|EE|FI|FR|EL|IE|IT|HR|LV|LT|LU|MT|NL|XI|AT|PL|PT|RO|SE|SK|SI|ES|CZ|HU|CY).{2,12}",
                                    "example": "CHE-115.517.011"
                                },
                                "companyName": {
                                    "description": "Company name. For a sole proprietorship, name and surname must be entered.",
                                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                                    "name": "CompanyNameType",
                                    "type": "string",
                                    "maxLength": 255,
                                    "example": "MyCompany Name"
                                }
                            },
                            "additionalProperties": false,
                            "required": [
                                "brokerRegisterNo",
                                "companyName"
                            ]
                        },
                        "insurer": {
                            "$schema": "https://json-schema.org/draft/2019-09/schema",
                            "type": "object",
                            "description": "Insurer",
                            "properties": {
                                "companyId": {
                                    "description": "Unique company identification number (UID) for companies based in Switzerland or EU member states as specified in the UID register of the respective authority.",
                                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                                    "name": "CompanyIdType",
                                    "type": "string",
                                    "maxLength": 15,
                                    "pattern": "(CHE|BE|BG|DK|DE|EE|FI|FR|EL|IE|IT|HR|LV|LT|LU|MT|NL|XI|AT|PL|PT|RO|SE|SK|SI|ES|CZ|HU|CY).{2,12}",
                                    "example": "CHE-115.517.011"
                                },
                                "companyName": {
                                    "description": "Company name. For a sole proprietorship, name and surname must be entered.",
                                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                                    "name": "CompanyNameType",
                                    "type": "string",
                                    "maxLength": 255,
                                    "example": "MyCompany Name"
                                },
                                "insurerCode": {
                                    "description": "Insurer code",
                                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                                    "maxLength": 5,
                                    "pattern": "^([\\w\\D]*[\\w\\D][\\w\\D]*)$",
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false,
                            "required": [
                                "companyName",
                                "insurerCode"
                            ]
                        },
                        "otherExchangePartner": {
                            "$schema": "https://json-schema.org/draft/2019-09/schema",
                            "type": "object",
                            "description": "Other partner for data exchange",
                            "properties": {
